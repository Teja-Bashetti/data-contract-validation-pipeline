{
  "dataset": "customers",
  "version": "1.2",
  "description": "Test contract with a breaking change",
  "columns": {
    "customer_id": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "customer_name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true,
      "format": "email"
    },
    "age": {
      "type": "integer",
      "required": true,
      "min": 18,
      "max": 100
    },
    "city": {
      "type": "string",
      "required": true
    },
    "phone_number": {
      "type": "string",
      "required": false
    }
  }
}